YOUTUBE_API_KEY=your_youtube_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DATABASE_URL=sqlite:///./insightclips.db
CLIPS_STORAGE_PATH=./clips
APP_API_KEY=your_app_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# Cloudflare Worker proxying YouTube transcript fetches. Optional: without it,
# transcript requests go direct to YouTube instead of through the proxy.
TRANSCRIPT_PROXY_URL=https://yt-proxy.sharmakriti275.workers.dev

# Public base URL AssemblyAI POSTs completed transcripts back to. Required.
# In production this is the Render URL. For local dev use a tunnel
# (ngrok http 8000) - pointing it at production would deliver your local
# job's callback to the prod database, which has no matching row.
WEBHOOK_BASE_URL=https://your-render-url.onrender.com
